{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/push-guard.py\"",
            "timeout": 60,
            "statusMessage": "Pruefe den Push auf fremde PII und interne Infrastruktur"
          }
        ]
      }
    ]
  }
}
