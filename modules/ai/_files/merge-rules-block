#!/bin/zsh
# Maintain a managed rules block inside a writable agent instructions file.
#
# Two callers, both in modules/agent-integration.nix:
#   codex                     ~/.codex/AGENTS.md
#   antigravity + gemini-cli  ~/.gemini/GEMINI.md
#
# Neither agent has a home-manager option for its global instructions, and
# both files carry content the agent writes itself (hand-written notes,
# gemini-cli's `/memory add` appending "## Gemini Added Memories"). Symlinking
# them into the store would destroy that, so the block is merged in between
# markers instead — the same reasoning as codex-merge-config.py next door.
# Everything outside the markers survives byte for byte.
#
# usage: merge-rules-block <rules-file> <target>
#        merge-rules-block --remove <target>
set -euo pipefail

rules=${1:?rules file missing}
target=${2:?target missing}
[[ $rules == --remove || -s $rules ]] || { print -u2 "merge-rules-block: $rules is empty or missing"; exit 1 }

export MARK_BEGIN='<!-- BEGIN nix-darwin managed rules -- do not edit between the markers -->'
export MARK_END='<!-- END nix-darwin managed rules -->'

if [[ $rules == --remove ]]; then
  [[ -f $target ]] || exit 0
  perl -0777 -e 'exit(index(<>,$ENV{MARK_BEGIN}) < 0 ? 1 : 0)' "$target" || exit 0
  tmp=$(mktemp "${target}.XXXXXX")
  trap 'rm -f -- "$tmp"' EXIT
  # Remove only complete blocks; retain all bytes outside the markers.
  # An unterminated marker is ambiguous, so fail rather than discard user text.
  perl -0777 -pe '
    s/^\Q$ENV{MARK_BEGIN}\E\n.*?^\Q$ENV{MARK_END}\E\n?//gms;
    die "merge-rules-block: unterminated managed block\n" if /\Q$ENV{MARK_BEGIN}\E/;
  ' "$target" > "$tmp"
  mv -- "$tmp" "$target"
  trap - EXIT
  exit 0
fi

mkdir -p "${target:h}"
[[ -f $target ]] || : > "$target"

tmp=$(mktemp "${target}.XXXXXX")
trap 'rm -f -- "$tmp"' EXIT

# Strip any previous block, then normalise the tail to exactly one newline.
# Two passes on purpose: the second removes an UNTERMINATED begin marker
# through end of file. An interrupted run leaves exactly that, and a pattern
# requiring both markers would leak the fragment and then append a second
# block beside it — measured, before this pass existed.
#
# Markers travel through the environment so the shell never has to quote them
# into the perl source.
perl -0777 -pe '
    s/^\Q$ENV{MARK_BEGIN}\E\n.*?^\Q$ENV{MARK_END}\E\n?//gms;
    s/^\Q$ENV{MARK_BEGIN}\E\n.*\z//ms;
    s/\n+\z//;
' "$target" > "$tmp"

# Blank line between the hand-written part and the block, but only if there IS
# a hand-written part. Building the tail unconditionally here rather than
# appending conditionally is what makes repeated runs byte-identical.
{
  [[ -s $tmp ]] && print -- "" && print -- ""
  print -- "$MARK_BEGIN"
  cat -- "$rules"
  print -- "$MARK_END"
} >> "$tmp"

# Same filesystem, so the rename is atomic: an interrupted run leaves the
# temp file rather than a half-written AGENTS.md.
mv -- "$tmp" "$target"
trap - EXIT
