        "terminal.ansi.bright_red": "#ff5555ff",
        "terminal.ansi.bright_green": "#c3e887ff",
        "terminal.ansi.bright_yellow": "#fff067ff",
        "terminal.ansi.bright_blue": "#55a5ffff",
        "terminal.ansi.bright_magenta": "#c792eaff",
        "terminal.ansi.bright_cyan": "#08f0f0ff",
