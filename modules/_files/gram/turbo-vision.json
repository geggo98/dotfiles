          { "cursor": "#ffb86cff", "background": "#ffb86cff", "selection": "#ffb86c3d" },
          { "cursor": "#ff75b5ff", "background": "#ff75b5ff", "selection": "#ff75b53d" },
          { "cursor": "#45a9f9ff", "background": "#45a9f9ff", "selection": "#45a9f93d" },
          { "cursor": "#b084ebff", "background": "#b084ebff", "selection": "#b084eb3d" },
          { "cursor": "#e6e6e6ff", "background": "#e6e6e6ff", "selection": "#e6e6e63d" },
          { "cursor": "#19f9d8ff", "background": "#19f9d8ff", "selection": "#19f9d83d" },
          { "cursor": "#a9d72dff", "background": "#a9d72dff", "selection": "#a9d72d3d" }
