{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Turbo Vision",
  "author": "Stefan Schwetschke",
  "themes": [
    {
      "name": "Turbo Vision",
      "appearance": "dark",
      "style": {
        "background": "#012341ff",
