          "text.literal": { "color": "#a9d72dff" },
          "link_text": { "color": "#a9d72dff" },
          "link_uri": { "color": "#a9d72dff" },

          "string.escape": { "color": "#17bbddff" },
          "string.regex": { "color": "#17bbddff" },
          "string.special": { "color": "#17bbddff" },
          "selector": { "color": "#17bbddff" },
          "selector.pseudo": { "color": "#17bbddff" },

          "number": { "color": "#00d7ffff" },
          "boolean": { "color": "#fff067ff" },
          "constant": { "color": "#a9d72dff", "font_style": "italic" },
          "variant": { "color": "#a9d72dff" },

          "function": { "color": "#fff067ff", "font_style": "italic" },
          "constructor": { "color": "#fff067ff", "font_style": "italic" },

          "type": { "color": "#fff067ff" },
          "enum": { "color": "#fff067ff" },
          "namespace": { "color": "#fff067ff" },

          "attribute": { "color": "#fff067ff" },
          "preproc": { "color": "#bbb529ff", "font_style": "italic" },

          "property": { "color": "#ff5555ff" },
          "tag": { "color": "#ff5555ff", "font_style": "italic" },
          "embedded": { "color": "#ff5555ff" },

          "variable": { "color": "#b9c3cdff", "font_style": "italic" },
          "variable.parameter": { "color": "#08f0f0ff" },
          "variable.special": { "color": "#7878ffff", "font_style": "italic", "font_weight": 700 },
          "label": { "color": "#08f0f0ff" },

          "title": { "color": "#50b4beff", "font_weight": 700 },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },

          "hint": { "color": "#96969dff" },
          "predictive": { "color": "#4b575fff", "font_style": "italic" },

          "diff.plus": { "color": "#a9d72dff" },
          "diff.minus": { "color": "#ff5555ff" }
