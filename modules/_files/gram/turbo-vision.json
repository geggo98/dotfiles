        "surface.background": "#011e33ff",
        "elevated_surface.background": "#011e33ff",

        "border": "#30404fff",
        "border.variant": "#30404fff",
        "border.focused": "#08e3dbff",
        "border.selected": "#08e3dbff",
        "border.disabled": "#1e2a30ff",
        "border.transparent": "#00000000",

        "element.background": "#011e33ff",
        "element.hover": "#032d55ff",
        "element.active": "#173d59ff",
        "element.selected": "#173d59ff",
        "element.disabled": "#011e33ff",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#032d55ff",
        "ghost_element.active": "#173d59ff",
        "ghost_element.selected": "#173d59ff",
        "ghost_element.disabled": "#011e33ff",
        "drop_target.background": "#173d5980",

        "text": "#b9c3cdff",
        "text.muted": "#808080ff",
        "text.placeholder": "#4b575fff",
        "text.disabled": "#4b575fff",
        "text.accent": "#08e3dbff",

        "icon": "#b9c3cdff",
        "icon.muted": "#808080ff",
        "icon.placeholder": "#4b575fff",
        "icon.disabled": "#4b575fff",
        "icon.accent": "#08e3dbff",

